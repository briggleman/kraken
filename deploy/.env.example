# Kraken deploy environment — copy to deploy/.env and edit.
#
# The full-stack compose file (docker-compose.full.yml) picks these up:
#   docker compose --env-file deploy/.env -f deploy/docker-compose.full.yml up -d
#
# For the bare-metal path (systemd), install.sh writes the same variables
# to /etc/kraken/panel.env and /etc/kraken/agent.env.

# ---- required ----------------------------------------------------------

# Master key used to seal all at-rest secrets (Steam creds, CA key,
# SFTP keys, integration tokens). Generate once and keep it — losing it
# means every stored secret becomes unrecoverable.
#
#   openssl rand -base64 32
KRAKEN_SECRETS_KEY=

# ---- recommended -------------------------------------------------------

# First admin. On a fresh database a bootstrap user is created with these
# credentials; on subsequent starts the value is ignored (the login
# persists in Postgres). Leave the password blank to let the Panel
# generate a strong random one and log it once.
KRAKEN_BOOTSTRAP_ADMIN_USER=admin
KRAKEN_BOOTSTRAP_ADMIN_PASSWORD=

# Where the Agent stores game-server data on the host. Bind-mounted into
# every game container as /data (Linux) / C:\data (Windows).
#
# In the containerized-Agent stack this path is used on BOTH sides of the
# Agent's volume mount, so the Agent and the Docker daemon name the data root
# identically. Bind sources are resolved by the daemon on the host, so a
# container-only path would hand game servers a different directory than the
# Agent's file browser, backups, and SFTP see. Use an absolute path.
KRAKEN_DATA_DIR=/var/lib/kraken/server-data

# Where the Agent writes local backups before optional off-site replication.
KRAKEN_BACKUP_DIR=/var/lib/kraken/agent-backups

# ---- optional ----------------------------------------------------------

# Panel HTTP port. Default 8080.
# KRAKEN_HTTP_PORT=8080

# SFTP listen address. Expose to trusted networks only.
# KRAKEN_SFTP_ADDR=:2022

# Comma-separated list of external origins allowed to hit the Panel API
# and open WebSockets. Same-origin is always allowed; localhost is always
# allowed in dev. Set this for reverse-proxied deployments.
# KRAKEN_ALLOWED_ORIGINS=https://kraken.example.com

# Reverse proxies whose forwarding headers the Panel may believe. Leave unset
# unless a proxy really fronts the Panel. Behind Caddy/nginx/Traefik or a
# Cloudflare Tunnel the Panel otherwise sees the proxy as the client on every
# request: every audit row records the proxy, and the per-client rate limiters
# on login and download-token redemption become one bucket shared by everybody.
# A cloudflared sidecar or any proxy on this host:
# KRAKEN_TRUSTED_PROXIES=127.0.0.0/8,::1/128

# Panel log level: debug, info (default), warn, error. debug surfaces the
# refused download-token redemptions and other deliberately quiet diagnostics.
# KRAKEN_LOG_LEVEL=debug

# Set to off to disable the per-client rate limiters on login and
# download-token redemption (e.g. when your edge already does this).
# KRAKEN_RATE_LIMITS=off

# How many days of audit log to keep (default 90). A daily job deletes what is
# older, in batches. Set 0 to keep every entry forever — for a log shipper or a
# compliance rule that owns retention instead.
# KRAKEN_AUDIT_RETENTION_DAYS=90

# Content-Security-Policy mode: enforce (default), report-only, or off.
# Run report-only for a day after putting the Panel behind a new proxy or CDN,
# check the browser console for violations, then switch back to enforcing.
# KRAKEN_CSP=report-only
#
# Extra CSP sources, comma-separated. The shipped policy is same-origin only, so
# a CDN that injects a script at the edge needs its host allowed here. Cloudflare
# Web Analytics is the common one:
# KRAKEN_CSP_SCRIPT_SRC=https://static.cloudflareinsights.com
# KRAKEN_CSP_CONNECT_SRC=

# Pin to a specific Panel/Agent image (default: :latest).
# KRAKEN_PANEL_IMAGE=ghcr.io/briggleman/kraken-panel:v0.5.0
# KRAKEN_AGENT_IMAGE=ghcr.io/briggleman/kraken-agent:v0.5.0
