# /etc/systemd/system/kraken-agent.service
#
# Kraken Agent — per-host daemon; launches game-server containers via the
# local Docker daemon. Runs as the `kraken` system user (member of the
# `docker` group so it can talk to /var/run/docker.sock). Binds :9090 for
# Panel gRPC and :2022 for SFTP.

[Unit]
Description=Kraken Agent (node daemon)
Documentation=https://github.com/briggleman/kraken
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=kraken
Group=kraken
SupplementaryGroups=docker
# install.sh writes agent.env. A config file works too — drop
# /etc/kraken/agent.yaml (see deploy/agent.example.yaml) and the Agent finds it
# on its own; anything in agent.env still wins, so the two can coexist during a
# migration.
EnvironmentFile=-/etc/kraken/agent.env
Environment=KRAKEN_STATE_DIR=/var/lib/kraken
# NOT /usr/local/bin. The Panel can push a new agent build over the UpdateAgent
# RPC and the agent replaces its own binary in place, which needs write on the
# *directory* (it creates kraken-agent.new and renames the running file to
# .old). /usr/local/bin is root-owned 0755 and, under ProtectSystem=strict
# below, read-only anyway — so self-update failed there twice over. /opt/kraken/bin
# is kraken-owned and holds exactly one replaceable file, which is as narrow as
# this permission gets. install.sh keeps /usr/local/bin/kraken-agent as a symlink
# for the command line; /proc/self/exe resolves through it, so the updater still
# sees the real path here.
ExecStart=/opt/kraken/bin/kraken-agent
Restart=on-failure
RestartSec=5s
# --- hardening ------------------------------------------------------------
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# Needs write for state, host key, server data, and backups. The default
# server-data + backup dirs are under /var/lib/kraken but operators can
# point elsewhere via KRAKEN_DATA_DIR / KRAKEN_BACKUP_DIR — add those
# via a systemd drop-in (systemctl edit kraken-agent) if you move them.
# /opt/kraken/bin is the self-update target (see ExecStart) — without it here,
# ProtectSystem=strict makes the swap fail with EROFS.
ReadWritePaths=/var/lib/kraken /etc/kraken /opt/kraken/bin
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
